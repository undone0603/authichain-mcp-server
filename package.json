{
  "name": "authichain-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the AuthiChain product-authentication API (early development): product lookup, registry search, EU DPP checks and pricing for any MCP client.",
  "type": "module",
  "license": "MIT",
  "author": "Zachary Kietzman",
  "homepage": "https://github.com/undone0603/authichain-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undone0603/authichain-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/undone0603/authichain-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "authichain",
    "product-authentication",
    "provenance",
    "digital-product-passport"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "bin": {
    "authichain-mcp-server": "bin/authichain-mcp-server.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
